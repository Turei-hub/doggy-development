rules_version = '2';

// Doggy Development — gallery rules
//
// The whole moderation guarantee lives in this file. It is enforced by Firebase
// on the server, so it holds even if someone edits the site's JavaScript in
// their browser or calls the API directly.
//
//   - the public can only ever READ dogs whose status is "approved"
//   - the public can only ever CREATE dogs whose status is "pending"
//   - only the admin can change a status, edit, or delete
//
// The UID below is the owner's Google account. To add a second admin later,
// add their UID to the list and redeploy the rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.uid in [
               's2lHLoXv0yVxsLph8rG49QvtLqH3'
             ];
    }

    function isShortString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // A submission from the public form. Deliberately strict: exactly these
    // fields, nothing else, and always pending.
    function isValidSubmission(d) {
      return d.keys().hasOnly(['name','where','story','photo','status','created'])
          && d.keys().hasAll(['name','photo','status','created'])
          && d.status == 'pending'
          && isShortString(d.name, 40)
          && d.name.size() > 0
          && isShortString(d.get('where', ''), 50)
          && isShortString(d.get('story', ''), 320)
          // photo is a base64 data URI; cap it so nobody can fill the quota
          && d.photo is string
          && d.photo.size() > 0
          && d.photo.size() <= 400000
          && d.photo.matches('^data:image/(jpeg|png|webp);base64,.*')
          // stops backdating, and gives the queue a reliable sort order
          && d.created == request.time;
    }

    match /dogs/{dogId} {

      // Public reads are limited to approved dogs. Because of this, a client
      // query MUST include where('status','==','approved') or Firestore
      // refuses the whole list. The admin can read everything.
      allow read: if isAdmin() || resource.data.status == 'approved';

      // Anyone may submit a dog, but only ever as pending.
      allow create: if isValidSubmission(request.resource.data)
                    || (isAdmin() && request.resource.data.status in ['pending','approved']);

      // Approving, editing and deleting are yours alone.
      allow update, delete: if isAdmin();
    }

    // A booking enquiry from the public form.
    //
    // Note the difference from dogs: these are never publicly readable, not
    // even by whoever sent one. They hold a name, a phone number and a suburb,
    // so every read is restricted to the owner's account.
    function isValidBooking(d) {
      return d.keys().hasOnly(['name','phone','email','suburb','dog','message','status','created'])
          && d.keys().hasAll(['name','phone','status','created'])
          && d.status == 'new'
          && isShortString(d.name, 60)   && d.name.size() > 0
          && isShortString(d.phone, 30)  && d.phone.size() > 0
          && isShortString(d.get('email', ''), 120)
          && isShortString(d.get('suburb', ''), 60)
          && isShortString(d.get('dog', ''), 80)
          && isShortString(d.get('message', ''), 800)
          && d.created == request.time;
    }

    match /bookings/{bookingId} {
      // Owner only. There is no public read of any kind here.
      allow read: if isAdmin();

      // Anyone may send an enquiry, but only as a new one.
      allow create: if isValidBooking(request.resource.data);

      allow update, delete: if isAdmin();
    }

    // Nothing else in the database is reachable from the web.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
